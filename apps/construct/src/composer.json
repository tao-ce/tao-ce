{
  "name": "oat-sa/tao-community",
  "license": "GPL-2.0-only",
  "config": {
    "platform": {
      "php": "8.3"
    },
    "preferred-install": "source",
    "allow-plugins": {
      "oat-sa/oatbox-extension-installer": true,
      "oat-sa/composer-npm-bridge": true,
      "php-http/discovery": true
    }
  },
  "support": {
    "issues": "http://forge.taotesting.com",
    "forum": "http://forum.taotesting.com"
  },
  "authors": [
    {
      "homepage": "http://www.taotesting.com",
      "name": "Open Assessment Technologies S.A."
    }
  ],
  "keywords": [
    "tao",
    "oat",
    "computer-based-assessment"
  ],
  "homepage": "http://www.taotesting.com",
  "prefer-stable": true,
  "require": {
    "oat-sa/generis": "17.1.2",
    "oat-sa/tao-core": "56.3.5.2",
    "oat-sa/extension-tao-community": "11.1.7",
    "oat-sa/extension-tao-funcacl": "7.4.10",
    "oat-sa/extension-tao-dac-simple": "10.0.1",
    "oat-sa/extension-tao-itemqti": "32.5.13.1",
    "oat-sa/extension-tao-testqti": "50.3.6",
    "oat-sa/extension-tao-testtaker": "8.13.7",
    "oat-sa/extension-tao-group": "7.10.5",
    "oat-sa/extension-tao-item": "13.1.5",
    "oat-sa/extension-tao-itemqti-pci": "9.4.5.2",
    "oat-sa/extension-tao-test": "16.4.21",
    "oat-sa/extension-tao-outcome": "13.8.6",
    "oat-sa/extension-tao-delivery": "16.1.1",
    "oat-sa/extension-tao-delivery-rdf": "14.26.6",
    "oat-sa/extension-tao-lti": "19.1.2.2",
    "oat-sa/extension-tao-revision": "11.0.2",
    "oat-sa/extension-tao-mediamanager": "14.0.3",
    "oat-sa/extension-pcisample": "3.9.8",
    "oat-sa/extension-tao-backoffice": "7.1.6",
    "oat-sa/extension-tao-eventlog": "4.1.2",
    "oat-sa/extension-tao-task-queue": "6.10.0",
    "oat-sa/extension-tao-testqti-previewer": "3.17.1",
    "oat-sa/lib-generis-search": "2.3.1",
    "oat-sa/extension-tao-deliver-connect": "5.33.8.1",
    "oat-sa/extension-tao-deliver-pcis": "0.7.0",
    "oat-sa/extension-tao-testqti-export": "1.1.5",
    "oat-sa/extension-tao-test-preview-ui-loader": "1.36.1",
    "oat-sa/extension-tao-lti-consumer": "4.0.2",
    "oat-sa/extension-lti-test-review": "^3.9"

  },
  "require-dev": {
    "mikey179/vfsstream": "~1",
    "nimut/phpunit-merger": "~1",
    "phpdocumentor/reflection-docblock": "5.3.0 as 2.0.5",
    "phpspec/prophecy": "^1.15",
    "phpunit/phpunit": "^9.0"
  },
  "minimum-stability": "dev",
  "description": "TAO is an Open Source e-Testing platform that empowers you to build, deliver, and share innovative and engaging assessments online – in any language or subject matter."
}
