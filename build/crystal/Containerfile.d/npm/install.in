#include <macros.h>
#ifndef NPM_INSTALL_PACKAGES
#define NPM_INSTALL_PACKAGES
#endif

#ifdef NPM_DEV
#define NPM_DEV_OPTS
#else
#define NPM_DEV_OPTS --omit=dev
#endif

#ifndef NPM_INSTALL_OPTS
#define NPM_INSTALL_OPTS
#endif

ARG BUILD_NPM_REGISTRY
ARG BUILD_NPM_LOGIN="verdaccio"

RUN WITH_CACHE_NPM <<EORUN
set -eux
#include <snippets/npm-nvm.in>
#include <snippets/npm-registry.in>
npm install NPM_INSTALL_OPTS NPM_DEV_OPTS NPM_INSTALL_PACKAGES
EORUN

#undef NPM_INSTALL_OPTS
#undef NPM_INSTALL_PACKAGES
#undef NPM_DEV
